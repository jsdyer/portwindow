{
  "id": "portwindow",
  "title": "Port Window",
  "description": "Compare published cruise schedules across Pacific and Maritime ports, with clear source years and personal time buffers.",
  "category": "places",
  "tags": [
    "travel",
    "cruises",
    "Maritimes",
    "Halifax",
    "Charlottetown",
    "Sydney",
    "Saint John",
    "Vancouver",
    "Alaska",
    "schedule"
  ],
  "icon": "map",
  "url": "/portwindow/",
  "source": "https://github.com/jsdyer/portwindow",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "Official port schedules checked independently each day. Published years, missing releases and retained captures are shown per port; no live positions or crowd estimates.",
    "cadence": "Daily",
    "probes": [
      {
        "url": "https://coolcode.ca/portwindow/data/status.json",
        "path": [
          "checked_at"
        ],
        "precision": "minute",
        "label": "Oldest available schedule checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "schedule entries"
        }
      }
    ]
  }
}
