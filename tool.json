{
  "id": "portwindow",
  "title": "Port Window",
  "description": "Explore official cruise schedules, compare port days and plan your own time buffer.",
  "category": "places",
  "tags": [
    "travel",
    "cruises",
    "Vancouver",
    "Victoria",
    "Alaska",
    "schedule"
  ],
  "icon": "map",
  "url": "/portwindow/",
  "source": "https://github.com/jsdyer/portwindow",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "CLAA published cruise schedules for selected ports, checked daily. These are planned calls, not live ship positions or crowd estimates.",
    "cadence": "Daily",
    "probes": [
      {
        "url": "https://coolcode.ca/portwindow/data/status.json",
        "path": [
          "checked_at"
        ],
        "precision": "minute",
        "label": "Official port schedules checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "schedule entries"
        }
      }
    ]
  }
}
